{
  "name": "SchoolBridge Browser Preview",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "forwardPorts": [8001, 5173],
  "portsAttributes": {
    "8001": {
      "label": "SchoolBridge API",
      "onAutoForward": "notify",
      "visibility": "private"
    },
    "5173": {
      "label": "SchoolBridge Preview",
      "onAutoForward": "openBrowser",
      "visibility": "private"
    }
  },
  "postCreateCommand": "python -m pip install --upgrade pip && pip install -r backend/requirements.txt && npm --prefix frontend ci",
  "postStartCommand": "bash .devcontainer/start-preview.sh"
}
