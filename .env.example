# Copy this file to .env and replace both values with long, unique secrets.
POSTGRES_DB=schoolbridge
POSTGRES_USER=schoolbridge
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
SCHOOLBRIDGE_SECRET_KEY=replace-with-a-long-random-application-secret
# Public verification key generated by the SchoolBridge owner (not a private key).
SCHOOLBRIDGE_LICENSE_PUBLIC_KEY=replace-with-base64-owner-public-key

# The browser opens SchoolBridge at http://SERVER-LAN-IP:8080 by default.
SCHOOLBRIDGE_PORT=8080

# Keep wildcard only for a trusted, isolated LAN. For stricter deployments,
# set the exact browser origin, e.g. http://192.168.1.20:8080.
SCHOOLBRIDGE_CORS_ORIGINS=*

# PostgreSQL backups are stored in the persistent schoolbridge-backups volume.
SCHOOLBRIDGE_BACKUP_RETENTION_DAYS=30
