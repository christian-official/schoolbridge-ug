{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SchoolBridge",
  "version": "0.1.0",
  "identifier": "ug.co.schoolbridge.desktop",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SchoolBridge",
        "width": 1360,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": {
      "../desktop-resources/backend/": "backend/",
      "../desktop-resources/runtime/": "runtime/",
      "../desktop-resources/owner-activation-public-key.txt": "owner-activation-public-key.txt"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": {
        "installMode": "perMachine"
      }
    }
  }
}
